{
  "schemaVersion": "2.2",
  "description": "PPB V2 pinned S3 delivery; first production deploy STRICT six-composer-files allowlist; no migration",
  "parameters": {
    "Commit": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedPattern": "^[0-9a-f]{40}$",
      "description": "Approved Git commit"
    },
    "Sha256": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedPattern": "^[0-9a-f]{64}$",
      "description": "Pinned release tarball SHA256"
    },
    "RunId": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedPattern": "^[1-9][0-9]{0,19}$",
      "description": "GitHub Actions run number"
    },
    "RunAttempt": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedPattern": "^[1-9][0-9]{0,19}$",
      "description": "GitHub Actions attempt"
    },
    "Operation": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedValues": [
        "audit",
        "deploy"
      ],
      "description": "Audit by default; deploy requires separate approval",
      "default": "audit"
    },
    "Approval": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedValues": [
        "NONE",
        "DEPLOY-PPB-V2"
      ],
      "default": "NONE"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "prepareIsolatedDownload",
      "precondition": {
        "StringEquals": [
          "platformType",
          "Linux"
        ]
      },
      "inputs": {
        "timeoutSeconds": "30",
        "runCommand": [
          "set -eu",
          ": \"${SSM_Commit:?Commit not available}\"",
          ": \"${SSM_Sha256:?Sha256 not available}\"",
          ": \"${SSM_RunId:?RunId not available}\"",
          ": \"${SSM_RunAttempt:?RunAttempt not available}\"",
          ": \"${SSM_Operation:?Operation not available}\"",
          ": \"${SSM_Approval:?Approval not available}\"",
          "root=/www/ppb-v2-deploy/releases",
          "test -d \"$root\" && test ! -L \"$root\"",
          "case \"$SSM_Operation:$SSM_Approval\" in audit:NONE|deploy:DEPLOY-PPB-V2) ;; *) echo \"STOP=INVALID_APPROVAL\"; exit 1 ;; esac",
          "download=\"$root/ssm-incoming-${SSM_RunId}-${SSM_RunAttempt}\"",
          "test ! -L \"$download\"",
          "install -d -m 700 \"$download\"",
          "test ! -e \"$download/run-${SSM_RunId}-attempt-${SSM_RunAttempt}.tar.gz\"",
          "echo \"RESULT=PPB_V2_SSM_PREPARE_PASS\""
        ]
      }
    },
    {
      "action": "aws:downloadContent",
      "name": "downloadPrivatePinnedArtifact",
      "inputs": {
        "sourceType": "S3",
        "sourceInfo": "{\"path\":\"https://s3.us-east-1.amazonaws.com/ppb-v2-release-artifacts-429724121147-use1/releases/{{Commit}}/run-{{RunId}}-attempt-{{RunAttempt}}.tar.gz\"}",
        "destinationPath": "/www/ppb-v2-deploy/releases/ssm-incoming-{{RunId}}-{{RunAttempt}}"
      }
    },
    {
      "action": "aws:runShellScript",
      "name": "controlledRelease",
      "precondition": {
        "StringEquals": [
          "platformType",
          "Linux"
        ]
      },
      "inputs": {
        "timeoutSeconds": "1800",
        "runCommand": [
          "set -eu",
          ": \"${SSM_Commit:?Commit not available}\"",
          ": \"${SSM_Sha256:?Sha256 not available}\"",
          ": \"${SSM_RunId:?RunId not available}\"",
          ": \"${SSM_RunAttempt:?RunAttempt not available}\"",
          ": \"${SSM_Operation:?Operation not available}\"",
          ": \"${SSM_Approval:?Approval not available}\"",
          "case \"$SSM_Operation:$SSM_Approval\" in audit:NONE|deploy:DEPLOY-PPB-V2) ;; *) echo \"STOP=INVALID_APPROVAL\"; exit 1 ;; esac",
          "f=\"/www/ppb-v2-deploy/releases/ssm-incoming-${SSM_RunId}-${SSM_RunAttempt}/run-${SSM_RunId}-attempt-${SSM_RunAttempt}.tar.gz\"",
          "test -f \"$f\" && test ! -L \"$f\"",
          "state=/www/ppb-v2-deploy/current-release.json",
          "if [ -L \"$state\" ]; then echo \"STOP=UNSAFE_RELEASE_STATE\"; exit 1; fi",
          "if [ \"$SSM_Operation\" = deploy ] && [ ! -e \"$state\" ]; then",
          "  echo \"FIRST_DEPLOYMENT_STRICT_SCOPE_CHECK=START\"",
          "  audit_output=\"$(python3 /www/ppb-v2-deploy/scripts/controlled-deploy.py --operation audit --archive \"$f\" --sha256 \"$SSM_Sha256\" --commit \"$SSM_Commit\" --run-id \"$SSM_RunId\" --run-attempt \"$SSM_RunAttempt\" --confirmation NONE)\" || { echo \"STOP=FIRST_DEPLOYMENT_AUDIT_FAILED\"; exit 1; }",
          "  printf \"%s\\n\" \"$audit_output\"",
          "  printf \"%s\\n\" \"$audit_output\" | grep -Fxq \"COMMIT=$SSM_Commit\" || { echo \"STOP=AUDITED_COMMIT_MISMATCH\"; exit 1; }",
          "  for required in \"REPLACE_FILES=6\" \"ADD_FILES=0\" \"DELETE_FILES=0\" \"RESULT=PPB_V2_CONTROLLED_AUDIT_PASS\"; do",
          "    printf \"%s\\n\" \"$audit_output\" | grep -Fxq \"$required\" || { echo \"STOP=FIRST_DEPLOYMENT_SCOPE_MISMATCH:$required\"; exit 1; }",
          "  done",
          "  short=\"$(printf \"%s\" \"$SSM_Commit\" | cut -c1-12)\"",
          "  candidate=\"/www/ppb-v2-deploy/releases/candidate-$short\"",
          "  live=/www/wwwroot/ppbaos.com",
          "  for rel in vendor/composer/autoload_classmap.php vendor/composer/autoload_files.php vendor/composer/autoload_psr4.php vendor/composer/autoload_static.php vendor/composer/installed.json vendor/composer/installed.php; do",
          "    test -f \"$candidate/$rel\" && test ! -L \"$candidate/$rel\" || { echo \"STOP=FIRST_DEPLOYMENT_CANDIDATE_MISSING:$rel\"; exit 1; }",
          "    test -f \"$live/$rel\" && test ! -L \"$live/$rel\" || { echo \"STOP=FIRST_DEPLOYMENT_LIVE_FILE_MISSING:$rel\"; exit 1; }",
          "    if cmp -s \"$candidate/$rel\" \"$live/$rel\"; then echo \"STOP=FIRST_DEPLOYMENT_EXPECTED_DIFF_NOT_PRESENT:$rel\"; exit 1; fi",
          "  done",
          "  echo \"RESULT=PPB_V2_FIRST_DEPLOYMENT_SIX_FILES_SCOPE_PASS\"",
          "fi",
          "exec python3 /www/ppb-v2-deploy/scripts/controlled-deploy.py --operation \"$SSM_Operation\" --archive \"$f\" --sha256 \"$SSM_Sha256\" --commit \"$SSM_Commit\" --run-id \"$SSM_RunId\" --run-attempt \"$SSM_RunAttempt\" --confirmation \"$SSM_Approval\""
        ]
      }
    }
  ]
}
