{
  "schemaVersion": "2.2",
  "description": "PPB V2 S3 delivery; live provider-cache gate; first deploy exactly 3 differences within 6 approved Composer metadata files",
  "parameters": {
    "Commit": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedPattern": "^[0-9a-f]{40}$",
      "description": "Approved Git commit"
    },
    "Sha256": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedPattern": "^[0-9a-f]{64}$",
      "description": "Pinned release tarball SHA256"
    },
    "RunId": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedPattern": "^[1-9][0-9]{0,19}$",
      "description": "GitHub Actions run number"
    },
    "RunAttempt": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedPattern": "^[1-9][0-9]{0,19}$",
      "description": "GitHub Actions attempt"
    },
    "Operation": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedValues": [
        "audit",
        "deploy"
      ],
      "description": "Audit by default; deploy requires separate approval",
      "default": "audit"
    },
    "Approval": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedValues": [
        "NONE",
        "DEPLOY-PPB-V2"
      ],
      "default": "NONE"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "prepareIsolatedDownload",
      "precondition": {
        "StringEquals": [
          "platformType",
          "Linux"
        ]
      },
      "inputs": {
        "timeoutSeconds": "30",
        "runCommand": [
          "set -eu",
          ": \"${SSM_Commit:?Commit not available}\"",
          ": \"${SSM_Sha256:?Sha256 not available}\"",
          ": \"${SSM_RunId:?RunId not available}\"",
          ": \"${SSM_RunAttempt:?RunAttempt not available}\"",
          ": \"${SSM_Operation:?Operation not available}\"",
          ": \"${SSM_Approval:?Approval not available}\"",
          "root=/www/ppb-v2-deploy/releases",
          "test -d \"$root\" && test ! -L \"$root\"",
          "case \"$SSM_Operation:$SSM_Approval\" in audit:NONE|deploy:DEPLOY-PPB-V2) ;; *) echo \"STOP=INVALID_APPROVAL\"; exit 1 ;; esac",
          "download=\"$root/ssm-incoming-${SSM_RunId}-${SSM_RunAttempt}\"",
          "test ! -L \"$download\"",
          "install -d -m 700 \"$download\"",
          "test ! -e \"$download/run-${SSM_RunId}-attempt-${SSM_RunAttempt}.tar.gz\"",
          "echo \"RESULT=PPB_V2_SSM_PREPARE_PASS\""
        ]
      }
    },
    {
      "action": "aws:downloadContent",
      "name": "downloadPrivatePinnedArtifact",
      "inputs": {
        "sourceType": "S3",
        "sourceInfo": "{\"path\":\"https://s3.us-east-1.amazonaws.com/ppb-v2-release-artifacts-429724121147-use1/releases/{{Commit}}/run-{{RunId}}-attempt-{{RunAttempt}}.tar.gz\"}",
        "destinationPath": "/www/ppb-v2-deploy/releases/ssm-incoming-{{RunId}}-{{RunAttempt}}"
      }
    },
    {
      "action": "aws:runShellScript",
      "name": "controlledRelease",
      "precondition": {
        "StringEquals": [
          "platformType",
          "Linux"
        ]
      },
      "inputs": {
        "timeoutSeconds": "1800",
        "runCommand": [
          "set -eu",
          ": \"${SSM_Commit:?Commit not available}\"",
          ": \"${SSM_Sha256:?Sha256 not available}\"",
          ": \"${SSM_RunId:?RunId not available}\"",
          ": \"${SSM_RunAttempt:?RunAttempt not available}\"",
          ": \"${SSM_Operation:?Operation not available}\"",
          ": \"${SSM_Approval:?Approval not available}\"",
          "case \"$SSM_Operation:$SSM_Approval\" in audit:NONE|deploy:DEPLOY-PPB-V2) ;; *) echo \"STOP=INVALID_APPROVAL\"; exit 1 ;; esac",
          "f=\"/www/ppb-v2-deploy/releases/ssm-incoming-${SSM_RunId}-${SSM_RunAttempt}/run-${SSM_RunId}-attempt-${SSM_RunAttempt}.tar.gz\"",
          "test -f \"$f\" && test ! -L \"$f\"",
          "echo \"=== LIVE PROVIDER CACHE COMPATIBILITY CHECK ===\"",
          "audit_output=\"$(python3 /www/ppb-v2-deploy/scripts/controlled-deploy.py --operation audit --archive \"$f\" --sha256 \"$SSM_Sha256\" --commit \"$SSM_Commit\" --run-id \"$SSM_RunId\" --run-attempt \"$SSM_RunAttempt\" --confirmation NONE)\" || { echo \"STOP=DEPLOYMENT_AUDIT_FAILED\"; exit 1; }",
          "printf \"%s\\n\" \"$audit_output\"",
          "printf \"%s\\n\" \"$audit_output\" | grep -Fxq \"RESULT=PPB_V2_CONTROLLED_AUDIT_PASS\" || { echo \"STOP=DEPLOYMENT_AUDIT_MARKER_MISSING\"; exit 1; }",
          "printf \"%s\\n\" \"$audit_output\" | grep -Fxq \"COMMIT=$SSM_Commit\" || { echo \"STOP=DEPLOYMENT_COMMIT_MISMATCH\"; exit 1; }",
          "short=\"$(printf \"%s\" \"$SSM_Commit\" | cut -c1-12)\"",
          "candidate=\"/www/ppb-v2-deploy/releases/candidate-$short\"",
          "live=/www/wwwroot/ppbaos.com",
          "test -f \"$candidate/vendor/autoload.php\" && test ! -L \"$candidate/vendor/autoload.php\" || { echo \"STOP=CANDIDATE_AUTOLOAD_MISSING\"; exit 1; }",
          "php -r '$candidate = $argv[1];\n$live = $argv[2];\n$autoload = $candidate.\"/vendor/autoload.php\";\nif (!is_file($autoload)) { fwrite(STDERR, \"STOP=CANDIDATE_AUTOLOAD_MISSING\\n\"); exit(1); }\nrequire $autoload;\n$count = 0;\nforeach ([\"packages.php\", \"services.php\"] as $name) {\n  $path = $live.\"/bootstrap/cache/\".$name;\n  if (!is_file($path) || is_link($path)) { fwrite(STDERR, \"STOP=LIVE_PROVIDER_CACHE_MISSING_OR_LINK:\".$name.\"\\n\"); exit(1); }\n  $data = require $path;\n  if (!is_array($data)) { fwrite(STDERR, \"STOP=LIVE_PROVIDER_CACHE_NOT_ARRAY:\".$name.\"\\n\"); exit(1); }\n  $providers = [];\n  if ($name === \"packages.php\") {\n    foreach ($data as $package => $config) {\n      if (!is_array($config)) { continue; }\n      foreach ($config[\"providers\"] ?? [] as $provider) { $providers[] = $provider; }\n    }\n  } else {\n    foreach ($data[\"providers\"] ?? [] as $provider) { $providers[] = $provider; }\n  }\n  foreach ($providers as $provider) {\n    if (!is_string($provider) || $provider === \"\") { fwrite(STDERR, \"STOP=INVALID_CACHED_PROVIDER\\n\"); exit(1); }\n    try { $exists = class_exists($provider, true); }\n    catch (Throwable $ex) { $exists = false; }\n    if (!$exists) { fwrite(STDERR, \"STOP=CANDIDATE_MISSING_CACHED_PROVIDER:\".$provider.\"\\n\"); exit(1); }\n    $count++;\n  }\n}\nif ($count === 0) { fwrite(STDERR, \"STOP=NO_CACHED_PROVIDERS_FOUND\\n\"); exit(1); }\necho \"PROVIDER_CLASSES_CHECKED=\".$count.\"\\n\";\necho \"RESULT=PPB_V2_PROVIDER_CACHE_COMPAT_PASS\\n\";' \"$candidate\" \"$live\"",
          "state=/www/ppb-v2-deploy/current-release.json",
          "if [ -L \"$state\" ]; then echo \"STOP=UNSAFE_RELEASE_STATE\"; exit 1; fi",
          "if [ \"$SSM_Operation\" = deploy ] && [ ! -e \"$state\" ]; then",
          "  echo \"FIRST_DEPLOYMENT_STRICT_SCOPE_CHECK=START\"",
          "  printf \"%s\\n\" \"$audit_output\" | grep -Fxq \"COMMIT=$SSM_Commit\" || { echo \"STOP=AUDITED_COMMIT_MISMATCH\"; exit 1; }",
          "  for required in \"REPLACE_FILES=3\" \"ADD_FILES=0\" \"DELETE_FILES=0\" \"RESULT=PPB_V2_CONTROLLED_AUDIT_PASS\"; do",
          "    printf \"%s\\n\" \"$audit_output\" | grep -Fxq \"$required\" || { echo \"STOP=FIRST_DEPLOYMENT_SCOPE_MISMATCH:$required\"; exit 1; }",
          "  done",
          "  approved_diff_count=0",
          "  for rel in vendor/composer/autoload_classmap.php vendor/composer/autoload_files.php vendor/composer/autoload_psr4.php vendor/composer/autoload_static.php vendor/composer/installed.json vendor/composer/installed.php; do",
          "    test -f \"$candidate/$rel\" && test ! -L \"$candidate/$rel\" || { echo \"STOP=FIRST_DEPLOYMENT_CANDIDATE_MISSING:$rel\"; exit 1; }",
          "    test -f \"$live/$rel\" && test ! -L \"$live/$rel\" || { echo \"STOP=FIRST_DEPLOYMENT_LIVE_FILE_MISSING:$rel\"; exit 1; }",
          "    if ! cmp -s \"$candidate/$rel\" \"$live/$rel\"; then approved_diff_count=$((approved_diff_count + 1)); echo \"APPROVED_DIFF_FILE=$rel\"; fi",
          "  done",
          "  test \"$approved_diff_count\" -eq 3 || { echo \"STOP=FIRST_DEPLOYMENT_DIFFERENCES_OUTSIDE_APPROVED_SIX\"; exit 1; }",
          "  echo \"RESULT=PPB_V2_FIRST_DEPLOYMENT_THREE_OF_SIX_SCOPE_PASS\"",
          "fi",
          "if [ \"$SSM_Operation\" = audit ]; then echo \"RESULT=PPB_V2_SSM_AUDIT_CACHE_COMPAT_PASS\"; exit 0; fi",
          "if [ \"$SSM_Operation\" = deploy ]; then",
          "  test -f /www/ppb-v2-deploy/scripts/accept-v2.py && test ! -L /www/ppb-v2-deploy/scripts/accept-v2.py",
          "  printf \"1556753733a1b576c756e5b2786a0617028c3e166f575cc19bc70d87a9995396  /www/ppb-v2-deploy/scripts/accept-v2.py\\n\" | sha256sum -c - >/dev/null",
          "fi",
          "exec python3 /www/ppb-v2-deploy/scripts/controlled-deploy.py --operation \"$SSM_Operation\" --archive \"$f\" --sha256 \"$SSM_Sha256\" --commit \"$SSM_Commit\" --run-id \"$SSM_RunId\" --run-attempt \"$SSM_RunAttempt\" --confirmation \"$SSM_Approval\""
        ]
      }
    },
    {
      "action": "aws:runShellScript",
      "name": "functionalAcceptance",
      "inputs": {
        "timeoutSeconds": "120",
        "runCommand": [
          "set -eu",
          "if [ \"$SSM_Operation\" != deploy ]; then echo RESULT=FUNCTIONAL_ACCEPTANCE_NOT_REQUESTED; exit 0; fi",
          "exec /usr/bin/python3 -I /www/ppb-v2-deploy/scripts/accept-v2.py \"$SSM_Commit\""
        ]
      }
    }
  ]
}
