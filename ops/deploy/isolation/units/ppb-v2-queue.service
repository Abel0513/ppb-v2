# Reviewed template: never share the old web/queue Unix account.
[Unit]
Description=V2-only Laravel queue
After=network.target
[Service]
Type=simple
User=ppb-v2
Group=ppb-v2
WorkingDirectory=/www/wwwroot/ppbaos.com
ExecStart=/www/server/php/84/bin/php artisan queue:work --sleep=3 --tries=1 --max-time=600 --no-interaction
Restart=always
RestartSec=5
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
ReadWritePaths=/www/wwwroot/ppbaos.com
BindReadOnlyPaths=/www/wwwroot/ppbaos.com/.env
InaccessiblePaths=/www/wwwroot/3.231.229.26 /www/server/data /www/server/panel /www/ppb-v2-deploy -/run/mysqld -/etc/mysql -/etc/my.cnf
IPAddressDeny=169.254.0.0/16 fd00:ec2::254/128
UMask=0077
[Install]
WantedBy=multi-user.target
